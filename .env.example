# FounderAgent Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============ Supabase Configuration ============
# Get these values from your Supabase project settings

# Your Supabase project URL
# Find at: https://app.supabase.com/project/[project-id]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase publishable key (public - safe for frontend)
# Find at: https://app.supabase.com/project/[project-id]/settings/api
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Your Supabase secret key (SECRET - server-side only)
# Find at: https://app.supabase.com/project/[project-id]/settings/api
# NEVER expose this in your frontend code
SUPABASE_SECRET_KEY=your-secret-key-here

# ============ Authentication ============
# NextAuth or other auth configuration will go here
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=http://localhost:3000

# ============ API Keys ============
# Add API keys for AI services, payment processors, etc here
# OPENAI_API_KEY=your-openai-key
# STRIPE_PUBLIC_KEY=your-stripe-public-key
# STRIPE_SECRET_KEY=your-stripe-secret-key

# ============ Open Banking Sandbox Configuration ============
# Sandbox only. Do not put production Open Banking credentials in local files.
# Provider access tokens/secrets must only be used from server-side code.
OPEN_BANKING_DEFAULT_PROVIDER=plaid
OPEN_BANKING_ENV=sandbox
OPEN_BANKING_SANDBOX_MODE=fixture
PLAID_ENV=sandbox
PLAID_CLIENT_ID=your-plaid-sandbox-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_PRODUCTS=transactions,balance
PLAID_COUNTRY_CODES=GB,US
PLAID_REDIRECT_URI=http://localhost:3000/api/open-banking/plaid/callback
PLAID_SANDBOX_INSTITUTION_ID=ins_117650
PLAID_SANDBOX_INITIAL_PRODUCTS=transactions
TRUELAYER_CLIENT_ID=your-truelayer-sandbox-client-id
TRUELAYER_CLIENT_SECRET=your-truelayer-sandbox-client-secret
YAPILY_APPLICATION_ID=your-yapily-sandbox-application-id
YAPILY_APPLICATION_SECRET=your-yapily-sandbox-application-secret
TINK_CLIENT_ID=your-tink-sandbox-client-id
TINK_CLIENT_SECRET=your-tink-sandbox-client-secret
GOCARDLESS_BANK_ACCOUNT_DATA_SECRET_ID=your-gocardless-bank-account-data-secret-id
GOCARDLESS_BANK_ACCOUNT_DATA_SECRET_KEY=your-gocardless-bank-account-data-secret-key
ENABLE_BANKING_APPLICATION_ID=your-enable-banking-application-id
ENABLE_BANKING_PRIVATE_KEY_REFERENCE=your-enable-banking-private-key-reference

# ============ Feature Flags ============
# Use these to enable/disable features
NEXT_PUBLIC_ENABLE_AI_INSIGHTS=true
NEXT_PUBLIC_ENABLE_AUTO_CATEGORISATION=true
NEXT_PUBLIC_ENABLE_BANK_SYNC=false
NEXT_PUBLIC_ENABLE_OPEN_BANKING_SANDBOX=false

# ============ App Configuration ============
NEXT_PUBLIC_APP_NAME=FounderAgent
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
